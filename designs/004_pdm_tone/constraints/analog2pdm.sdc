create_clock -name sys_clk -period 37.037 [get_ports {sys_clk}]
create_clock -name pdm_a -period 325.521 [get_ports {pdm_clk_a}]
create_clock -name pdm_b -period 325.521 [get_ports {pdm_clk_b}]
create_generated_clock -name audio_a -source [get_ports {pdm_clk_a}] -multiply_by 4 [get_pins {port_a/domain/clock_source/pll/CLKOUT}]
create_generated_clock -name audio_b -source [get_ports {pdm_clk_b}] -multiply_by 4 [get_pins {port_b/domain/clock_source/pll/CLKOUT}]
set_clock_groups -asynchronous -group [get_clocks {sys_clk}] -group [get_clocks {pdm_a audio_a}] -group [get_clocks {pdm_b audio_b}]
create_generated_clock -name adc_bclk_a -source [get_pins {port_a/domain/clock_source/pll/CLKOUT}] -divide_by 4 [get_ports {adc_bclk_a}]
create_generated_clock -name adc_lrclk_a -source [get_pins {port_a/domain/clock_source/pll/CLKOUT}] -divide_by 256 [get_ports {adc_lrclk_a}]
set_input_delay -clock adc_bclk_a -clock_fall -max 50.0 [get_ports {adc_data_a}]
set_input_delay -clock adc_bclk_a -clock_fall -min -10.0 [get_ports {adc_data_a}]
set_output_delay -clock pdm_a -max 20.0 [get_ports {pdm_data_a}]
set_output_delay -clock pdm_a -min 0.0 [get_ports {pdm_data_a}]
set_output_delay -clock pdm_a -clock_fall -add_delay -max 20.0 [get_ports {pdm_data_a}]
set_output_delay -clock pdm_a -clock_fall -add_delay -min 0.0 [get_ports {pdm_data_a}]
create_generated_clock -name adc_bclk_b -source [get_pins {port_b/domain/clock_source/pll/CLKOUT}] -divide_by 4 [get_ports {adc_bclk_b}]
create_generated_clock -name adc_lrclk_b -source [get_pins {port_b/domain/clock_source/pll/CLKOUT}] -divide_by 256 [get_ports {adc_lrclk_b}]
set_input_delay -clock adc_bclk_b -clock_fall -max 50.0 [get_ports {adc_data_b}]
set_input_delay -clock adc_bclk_b -clock_fall -min -10.0 [get_ports {adc_data_b}]
set_output_delay -clock pdm_b -max 20.0 [get_ports {pdm_data_b}]
set_output_delay -clock pdm_b -min 0.0 [get_ports {pdm_data_b}]
set_output_delay -clock pdm_b -clock_fall -add_delay -max 20.0 [get_ports {pdm_data_b}]
set_output_delay -clock pdm_b -clock_fall -add_delay -min 0.0 [get_ports {pdm_data_b}]

# Only the first Gray-pointer synchronizer flops are asynchronous endpoints.
# Subsequent synchronizer stages, FIFO data paths and both audio datapaths stay timed.
set_false_path -to [get_pins {port_a/fifo/wg_r1*/D port_a/fifo/rg_w1*/D port_b/fifo/wg_r1*/D port_b/fifo/rg_w1*/D}]
